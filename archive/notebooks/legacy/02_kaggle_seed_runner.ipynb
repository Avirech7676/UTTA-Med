  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "from huggingface_hub import snapshot_download\n",
    "\n",
    "# Check potential data directories\n",
    "DATA_DIR = Path(\"/kaggle/input/camelyon17-wilds/data\")\n",
    "if not DATA_DIR.exists():\n",
    "    DATA_DIR = Path(\"/content/Camelyon17-Data/data\")\n",
    "DATA_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "parquet_files = list(DATA_DIR.glob(\"*.parquet\"))\n",
    "if len(parquet_files) < 21:\n",
    "    print(\"Downloading official Camelyon17-WILDS parquet dataset (~10.7 GB)...\")\n",
    "    snapshot_download(\n",
    "        repo_id=\"wltjr1007/Camelyon17-WILDS\",\n",
    "        repo_type=\"dataset\",\n",
    "        local_dir=str(DATA_DIR),\n",
    "        allow_patterns=[\"*.parquet\", \"*.json\", \"*.md\"]\n",
    "    )\n",
    "\n",
    "parquet_files = sorted(list(DATA_DIR.glob(\"*.parquet\")))\n",
    "print(f\"Verified {len(parquet_files)} parquet shards at {DATA_DIR}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Verify Protocol Guardrails (Step 2 Check)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
