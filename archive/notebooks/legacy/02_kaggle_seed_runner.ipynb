   "source": [
    "## 2. Setup Dependencies & Parquet Data Ingestion"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q pyarrow scikit-learn torchvision tqdm pyyaml huggingface_hub scipy"
