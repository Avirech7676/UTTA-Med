   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Execute Complete Authoritative Pipeline (Seed 123)\n",
    "\n",
    "Runs:\n",
    "1. Source training (10 epochs, Centers {0,3,4}, early stopping Center 1)\n",
    "2. Checkpoint restoration from peak AUROC epoch\n",
    "3. Zero-adaptation source baseline on Centers 1 & 2\n",
    "4. MC-Dropout ($N=20$) uncertainty analysis on Center 1\n",
    "5. $\\tau$ selection at 70th percentile of predictive variance\n",
    "6. Matched-coverage threshold calibration on Center 1\n",
    "7. Unlabeled stream adaptation on Center 2: Tent, EATA, Random, Confidence, Entropy, UTTA-Med\n",
    "8. Held-out target evaluation on Center 2\n",
    "9. JSON export to `results/metrics/camelyon17_resnet18_utta_gated_s123.json`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!python scripts/run_seed_pipeline.py \\\n",
    "    --seed 123 \\\n",
    "    --config configs/authoritative_resnet18_utta.yaml \\\n",
    "    --data-root \"{DATA_DIR}\" \\\n",
    "    --epochs 10 \\\n",
    "    --batch-size 64 \\\n",
    "    --mc-passes 20 \\\n",
    "    --lr 1e-5 \\\n",
    "    --bn-mode bn_freeze_stats \\\n",
    "    --percentile 70"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Review & Inspect Results JSON"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "json_path = Path(\"results/metrics/camelyon17_resnet18_utta_gated_s123.json\")\n",
    "if json_path.exists():\n",
    "    with open(json_path) as f:\n",
    "        data = json.load(f)\n",
    "    \n",
    "    print(\"=\" * 75)\n",
    "    print(\"SEED 123 AUTHORITATIVE RESULTS SUMMARY\")\n",
    "    print(\"=\" * 75)\n",
    "    print(f\"Selected UTTA Threshold (tau): {data['selected_threshold']:.6f}\")\n",
    "    print(f\"Center 1 Validation Coverage : {data['validation_coverage']*100:.2f}%\")\n",
    "    print(\"-\" * 75)\n",
    "    print(f\"{'Method':<12} | {'AUROC':<7} | {'AUPRC':<7} | {'F1':<7} | {'ECE':<7} | {'Harm Rate':<10} | {'Corr Rate':<10} | {'Coverage':<8}\")\n",
    "    print(\"-\" * 75)\n",
    "    \n",
    "    # Source Target Test\n",
    "    st = data['source_target_test']\n",
    "    print(f\"{'Source':<12} | {st['auroc']:.4f}  | {st['auprc']:.4f}  | {st['f1']:.4f}  | {st['ece']:.4f}  | {'N/A':<10} | {'N/A':<10} | {'N/A':<8}\")\n",
    "    \n",
    "    # TTA Methods\n",
    "    methods = ['tent_test', 'eata_test', 'random_test', 'confidence_test', 'entropy_test', 'utta_test']\n",
    "    for m_key in methods:\n",
    "        m = data[m_key]\n",
    "        name = m['method'].upper()\n",
    "        met = m['metrics']\n",
    "        harm = m['harm']\n",
    "        cov = f\"{m['coverage']*100:.1f}%\" if isinstance(m['coverage'], float) else str(m['coverage'])\n",
    "        print(f\"{name:<12} | {met['auroc']:.4f}  | {met['auprc']:.4f}  | {met['f1']:.4f}  | {met['ece']:.4f}  | {harm['harm_rate']*100:.2f}%     | {harm['correction_rate']*100:.2f}%     | {cov:<8}\")\n",
    "    print(\"=\" * 75)\n",
    "else:\n",
    "    print(f\"JSON not found at {json_path}\")"
   ]
  }
